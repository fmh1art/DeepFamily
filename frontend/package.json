{
  "name": "ask-dont-upload-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "e2e": "playwright test e2e/demo.spec.ts e2e/accessibility.spec.ts e2e/research-workflow.spec.ts --workers=2",
    "e2e:model-smoke": "playwright test e2e/model-smoke.spec.ts --project=chromium --workers=1",
    "capture:paper": "ASKDU_CAPTURE_PAPER=1 playwright test e2e/demo.spec.ts --project=chromium --workers=1",
    "capture:video": "playwright test e2e/capture-video.spec.ts --project=chromium --workers=1",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
