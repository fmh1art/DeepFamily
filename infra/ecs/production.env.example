# Non-secret ECS deployment template. Copy this file outside the repository,
# for example to /etc/askdu/askdu.env, replace demo.example.com, and chmod 600.

# Recommended single-ECS profile: keep 127.0.0.1 and terminate TLS in the host
# Nginx from host-nginx.conf.example. ALB profile: replace it with this ECS
# instance's exact private IP. Both profiles reject 0.0.0.0 and ::.
ASKDU_BIND_ADDRESS=127.0.0.1
ASKDU_HTTP_PORT=8080
ASKDU_CATALOG_MODE=single
ASKDU_CODA_RELEASE_MANIFEST=/app/data/manifests/coda-bench-v1-open-release.json
ASKDU_CODA_RELEASE_ROOT=/data/coda-bench

# The public HTTPS origin must be present in both lists. Keep Docker-internal
# and loopback hosts so container health and local operations continue to work.
ASKDU_CORS_ORIGINS=https://demo.example.com
ASKDU_TRUSTED_HOSTS=demo.example.com,localhost,127.0.0.1,api

ASKDU_MAX_CONCURRENT_RUNS=2
# Terminal-run questions, state, materialized tables, artifacts, and reports
# expire together after their last update. Choose 1--720 hours; 24 is suitable
# for the anonymous demo preview. Active runs are never pruned.
ASKDU_RUN_RETENTION_HOURS=24
ASKDU_LOG_MAX_SIZE=10m
ASKDU_LOG_MAX_FILES=5
# Use an explicit name so a restored snapshot can be activated by switching
# this one value; retain the prior volume name for instant rollback.
ASKDU_RUNTIME_VOLUME_NAME=ask-dont-upload_askdu-runtime
ASKDU_PLANNER_MODE=registry
ASKDU_PLANNER_MAX_ATTEMPTS=2
ASKDU_DISCOVERY_MAX_TURNS=16
ASKDU_PREPARATION_MAX_TURNS=6

# For the question-only research path, change CATALOG_MODE to
# coda_open_release and PLANNER_MODE to agentic. Put only the rotated secret in
# the external chmod-600 copy or a secret manager; never fill it in here. The
# remaining provider fields are project pins and must not be changed.
ASKDU_LLM_BASE_URL=https://aidp.bytedance.net/api/modelhub/online/v2/crawl?api-version=2024-03-01-preview
ASKDU_LLM_MODEL=gpt-5.5-2026-04-24
ASKDU_LLM_API_KEY=
ASKDU_LLM_API_STYLE=azure_chat
ASKDU_LLM_AUTH_SCHEME=api_key
ASKDU_LLM_TOKEN_FIELD=max_completion_tokens
ASKDU_LLM_TRUST_ENV_PROXY=false
ASKDU_LLM_TIMEOUT_SECONDS=120
ASKDU_LLM_MAX_RETRIES=2
