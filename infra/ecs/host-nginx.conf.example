# Install as /etc/nginx/conf.d/askdu.conf only after replacing the example
# hostname and certificate paths. This file is included from nginx's `http`
# context; it is the public edge for the recommended single-ECS profile.

limit_req_zone $binary_remote_addr zone=askdu_outer_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=askdu_outer_runs:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=askdu_outer_connections:10m;
limit_req_status 429;
limit_conn_status 429;

upstream askdu_web {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name demo.example.com;

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name demo.example.com;
    server_tokens off;

    ssl_certificate /etc/nginx/certs/demo.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/demo.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ASKDU_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Enable HSTS only after the final HTTPS hostname is verified; an incorrect
    # HSTS deployment is sticky in browsers.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 16k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 65s;

    location = /api/v1/runs {
        limit_req zone=askdu_outer_runs burst=4 nodelay;
        limit_conn askdu_outer_connections 3;

        proxy_pass http://askdu_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 900s;
    }

    location /api/ {
        limit_req zone=askdu_outer_api burst=40 nodelay;
        limit_conn askdu_outer_connections 8;

        proxy_pass http://askdu_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 900s;
    }

    location / {
        limit_req zone=askdu_outer_api burst=80 nodelay;
        limit_conn askdu_outer_connections 16;

        proxy_pass http://askdu_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 900s;
    }
}
