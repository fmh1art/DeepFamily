# Non-secret reference configuration. `run_demo.sh agentic` expects a private
# `.env` containing only ASKDU_LLM_API_KEY; never commit that file.
ASKDU_ENVIRONMENT_ID=coda-community-43
ASKDU_CATALOG_MODE=single
ASKDU_DATA_ROOT=./data/external/coda-bench/communities/community_43/full_community
ASKDU_PROVENANCE_MANIFEST=./data/manifests/coda-public-source-provenance-v1.json
ASKDU_CODA_RELEASE_MANIFEST=./data/manifests/coda-bench-v1-open-release.json
ASKDU_CODA_RELEASE_ROOT=./data/external/coda-bench
ASKDU_RUNTIME_ROOT=./runtime
ASKDU_MAX_REPAIR_ROUNDS=3
ASKDU_MAX_CONCURRENT_RUNS=2
# Disabled for local work so existing terminal runs are never removed unexpectedly.
# Public ECS preflight requires an explicit value between 1 and 720 hours.
# Active runs are never pruned.
ASKDU_RUN_RETENTION_HOURS=0
ASKDU_BIND_ADDRESS=127.0.0.1
ASKDU_HTTP_PORT=8080
ASKDU_LOG_MAX_SIZE=10m
ASKDU_LOG_MAX_FILES=5
ASKDU_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ASKDU_TRUSTED_HOSTS=localhost,127.0.0.1,testserver,api
ASKDU_PLANNER_MODE=registry
ASKDU_PLANNER_MAX_ATTEMPTS=2
ASKDU_DISCOVERY_MAX_TURNS=16
ASKDU_PREPARATION_MAX_TURNS=6

# Set PLANNER_MODE=agentic for the real question-only pipeline. Discovery,
# Preparation, Analysis planning, and repair share this one server-side client.
ASKDU_LLM_BASE_URL=https://aidp.bytedance.net/api/modelhub/online/v2/crawl?api-version=2024-03-01-preview
ASKDU_LLM_MODEL=gpt-5.5-2026-04-24
ASKDU_LLM_API_KEY=
# This URL is an Azure-compatible gateway root. The client extracts api-version
# and appends the deployment/chat-completions route; it is not a direct POST URL.
ASKDU_LLM_API_STYLE=azure_chat
# The Azure-compatible gateway authenticates with an api-key header.
ASKDU_LLM_AUTH_SCHEME=api_key
# The project provider contract is pinned to max_completion_tokens.
ASKDU_LLM_TOKEN_FIELD=max_completion_tokens
# Keep false unless the provider is reachable only through a trusted proxy.
ASKDU_LLM_TRUST_ENV_PROXY=false
ASKDU_LLM_TIMEOUT_SECONDS=120
ASKDU_LLM_MAX_RETRIES=2
